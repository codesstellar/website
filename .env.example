# Codesstellar Next.js + Payload CMS Environment Configuration

# 1. Payload CMS Secret (Required in production)
# Generate a secure random string (e.g. `openssl rand -base64 32`)
PAYLOAD_SECRET="replace-with-a-long-random-secret"

# 2. Database (PostgreSQL / Supabase)
# When deploying to Vercel with the Supabase Integration, Vercel automatically injects:
# - POSTGRES_URL_NON_POOLING (Direct connection on port 5432 - recommended for Payload schema sync)
# - POSTGRES_URL (Pooled connection)
# - DATABASE_URL / SUPABASE_DATABASE_URL
#
# For Local Development (using Docker Compose or local Postgres):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/codesstellar_dev"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/codesstellar_dev"

# 3. Public Canonical Site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 4. Media Storage (Vercel Blob)
# Required in production: Payload's Media collection uploads to Vercel Blob when this
# is set (falls back to local disk storage when unset, e.g. local dev).
# Create a Blob store in the Vercel dashboard (Storage tab) to get this token.
# BLOB_READ_WRITE_TOKEN=""

# 5. Optional AI Research Intelligence
# GEMINI_API_KEY=""
